{
  "name": "@fellowship42/website-contract",
  "version": "1.0.0",
  "description": "Versioned public website contract for reading a Fellowship42 church's published content",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && node --input-type=module --eval \"await import('./dist/index.js')\""
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idea7-cc/fellowship42.git",
    "directory": "packages/website-contract"
  },
  "homepage": "https://github.com/idea7-cc/fellowship42#readme",
  "bugs": {
    "url": "https://github.com/idea7-cc/fellowship42/issues"
  },
  "license": "Apache-2.0"
}
