{
  "name": "@fellowship42/instance",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/ui/tsconfig.json",
    "test": "vitest run && pnpm test:ui",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-file /dev/null",
    "cf-typegen:check": "wrangler types --check --config wrangler.jsonc --env-file /dev/null",
    "db:migrate": "wrangler d1 migrations apply fellowship42 --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply fellowship42 --remote --config wrangler.jsonc",
    "db:seed": "wrangler d1 execute fellowship42 --local --file seed.sql --config wrangler.jsonc",
    "db:seed:large": "node scripts/seed-large.mjs",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "agent:proof": "node scripts/agent-proof.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@fellowship42/brand": "workspace:*",
    "@fellowship42/management-protocol": "workspace:*",
    "@fellowship42/website-contract": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "~4.1.12",
    "wrangler": "^4.163.0"
  }
}
