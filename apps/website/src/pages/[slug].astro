---
import { decodeSlug, getEmDashEntry, getSeoMeta } from 'emdash'
import { PortableText } from 'emdash/ui'
import Base from '../layouts/Base.astro'
import { churchPages } from '../lib/church-pages'

const slug = decodeSlug(Astro.params.slug)
if (!slug) return Astro.rewrite('/404')
const { entry: page, isPreview, error } = await getEmDashEntry('pages', slug)
if (error) throw error
const builtIn = page ? null : churchPages[slug]
if (!page && !builtIn) return Astro.rewrite('/404')
const seo = page ? getSeoMeta(page) : null
---

<Base
  title={seo ? seo.ogTitle : builtIn!.title}
  description={seo?.description ?? builtIn?.description}
  preview={isPreview}
  content={page ? { collection: 'pages', id: page.data.id, slug } : undefined}
>
  <article>
    <h1 {...(page?.edit.title ?? {})}>{page ? page.data.title : builtIn!.title}</h1>
    <div class="prose-wide">
      <PortableText value={page ? page.data.content : builtIn!.blocks} />
    </div>
  </article>
</Base>
