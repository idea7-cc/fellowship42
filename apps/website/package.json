{
  "name": "@fellowship42/website",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "description": "The EmDash church website a Fellowship42 installation deploys beside the instance",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev --host localhost --port 4322",
    "build": "astro build",
    "preview": "astro preview --host localhost --port 4322",
    "typecheck": "astro check",
    "test": "vitest run",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-file /dev/null",
    "cf-typegen:check": "wrangler types --check --config wrangler.jsonc --env-file /dev/null",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/react": "6.0.6",
    "@emdash-cms/cloudflare": "1.0.1",
    "@fellowship42/brand": "workspace:*",
    "@fellowship42/emdash": "workspace:*",
    "@fellowship42/website-contract": "workspace:*",
    "astro": "^7.3.3",
    "emdash": "1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.151.3"
  }
}
